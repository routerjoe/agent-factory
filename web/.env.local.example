# Database (Neon)
# Use the "Pooled connection" string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/foundry?sslmode=require

# Clerk
# From https://dashboard.clerk.com/apps -> your app -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk URL config (these match the routes scaffolded in src/app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Single-user gate. Defense-in-depth on top of Clerk's allowlist.
ALLOWED_EMAIL=you@example.com
